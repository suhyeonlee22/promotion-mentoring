# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite DB 파일
*.db
*.db-*

# 커밋해도 되는 env 파일 (비밀정보 없음)
!.env.example
!.env.test


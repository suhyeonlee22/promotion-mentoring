{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:passwords": "tsx src/db/set-passwords.ts",
    "db:reset": "drizzle-kit push --force && tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test:prepare": "dotenv run -q -f .env.test -- drizzle-kit push --force",
    "test": "npm run test:prepare && vitest run",
    "test:watch": "npm run test:prepare && vitest"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "bcryptjs": "3.0.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
